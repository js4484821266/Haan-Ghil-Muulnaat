<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="@color/navy_surface"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_metrics_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/navy_text" />

        <TextView
            android:id="@+id/modelFaceCountValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/metric_face_count_placeholder"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/navy_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/metric_face_count_help"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/navy_text_muted" />

        <TextView
            android:id="@+id/modelLabelShiftValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/metric_label_shift_placeholder"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/navy_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/metric_label_shift_help"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/navy_text_muted" />

        <TextView
            android:id="@+id/modelScoreValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/metric_score_placeholder"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/navy_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/metric_score_help"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/navy_text_muted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
