<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <Button
        android:id="@+id/technicalDetailsToggle"
        style="@style/Widget.HaanGhilMuulnaat.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/technical_details_hidden" />

    <LinearLayout
        android:id="@+id/technicalDetailsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <include
            android:id="@+id/modelMetrics"
            layout="@layout/main_model_metrics_card" />

        <include
            android:id="@+id/qualityMetrics"
            layout="@layout/main_quality_metrics_card" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="@string/result_placeholder"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/navy_text_muted" />
    </LinearLayout>

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/save_protected_image" />
</LinearLayout>
