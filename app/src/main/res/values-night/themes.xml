<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HaanGhilMuulnaat" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/navy_black</item>
        <item name="android:statusBarColor">@color/navy_black</item>
        <item name="android:navigationBarColor">@color/navy_black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:textColorPrimary">@color/navy_text</item>
        <item name="android:textColorSecondary">@color/navy_text_muted</item>
        <item name="android:textColorTertiary">@color/navy_text_muted</item>
        <item name="android:textColorHint">@color/navy_text_muted</item>
        <item name="colorControlNormal">@color/navy_text_muted</item>
        <item name="colorControlActivated">@color/navy_secondary</item>
        <item name="colorControlHighlight">@color/navy_secondary_container</item>
        <item name="android:colorButtonNormal">@color/navy_button</item>
        <item name="colorPrimary">@color/navy_primary</item>
        <item name="colorOnPrimary">@color/navy_button_text</item>
        <item name="colorPrimaryContainer">@color/navy_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/navy_text</item>
        <item name="colorSecondary">@color/navy_secondary</item>
        <item name="colorOnSecondary">@color/navy_button_text</item>
        <item name="colorSecondaryContainer">@color/navy_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/navy_text</item>
        <item name="colorTertiary">@color/navy_primary</item>
        <item name="colorOnTertiary">@color/navy_button_text</item>
        <item name="colorSurface">@color/navy_surface</item>
        <item name="colorOnSurface">@color/navy_text</item>
        <item name="colorSurfaceVariant">@color/navy_surface_high</item>
        <item name="colorOnSurfaceVariant">@color/navy_text_muted</item>
        <item name="android:colorBackground">@color/navy_black</item>
        <item name="android:colorBackgroundFloating">@color/navy_surface</item>
        <item name="colorOutline">@color/navy_outline</item>
        <item name="colorError">@color/navy_error</item>
        <item name="colorErrorContainer">@color/navy_error_container</item>
        <item name="android:colorAccent">@color/navy_secondary</item>
        <item name="buttonStyle">@style/Widget.HaanGhilMuulnaat.Button</item>
        <item name="materialButtonStyle">@style/Widget.HaanGhilMuulnaat.Button</item>
        <item name="android:buttonStyle">@style/Widget.HaanGhilMuulnaat.Button</item>
    </style>

    <style name="Widget.HaanGhilMuulnaat.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/navy_button</item>
        <item name="android:backgroundTint">@color/navy_button</item>
        <item name="android:textColor">@color/navy_button_text</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.HaanGhilMuulnaat.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/navy_button</item>
        <item name="android:backgroundTint">@color/navy_button</item>
        <item name="android:textColor">@color/navy_button_text</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Theme.HaanGhilMuulnaat.ShareForwarder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
